# Sentry internal integration (org-wide) — HMAC secret for verifying the "sentry-hook-signature" header
SENTRY_WEBHOOK_SECRET=

# Sentry API — used by the get_sentry_issue_events tool to pull more sample events
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=

# GitHub App (bot identity, installed per-repo: Contents:read, Pull requests:write, Metadata:read)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Vercel log drain -> /api/ingest/vercel-logs. Set this same value as the drain's shared secret.
VERCEL_LOG_DRAIN_SECRET=

# Ops Supabase project (dedicated to this tool — registry + investigations + ingested vercel logs)
SUPABASE_OPS_URL=
SUPABASE_OPS_SERVICE_ROLE_KEY=

# --- Per-account credentials -------------------------------------------
# Projects can span multiple Vercel accounts and multiple Supabase orgs.
# Each row in the `projects` table points at *which* of these env vars to
# use via `vercel_token_ref` / `supabase_management_token_ref`. Start with
# the _DEFAULT ones; add more (e.g. VERCEL_TOKEN_CLIENTX,
# SUPABASE_MANAGEMENT_TOKEN_CLIENTX) as new accounts/orgs come up, then
# point the relevant project row at the new ref name. No code change needed
# to add an account — just a new env var + a value in the projects table.

VERCEL_TOKEN_DEFAULT=
SUPABASE_MANAGEMENT_TOKEN_DEFAULT=

# Claude
ANTHROPIC_API_KEY=

# Slack incoming webhook for posting investigation reports
SLACK_WEBHOOK_URL=

# Set by you, checked by Vercel Cron's request to /api/cron/daily-investigation
# (Vercel sends "Authorization: Bearer $CRON_SECRET" automatically once this is set)
CRON_SECRET=

# HTTP Basic Auth in front of the dashboard + investigation/settings API routes.
# Webhook/ingest/cron routes are exempt — they verify themselves. Required: the
# dashboard fails closed (500) if DASHBOARD_PASSWORD is unset.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
